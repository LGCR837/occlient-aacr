<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorBubbleIn" />
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp" />
            <stroke android:width="1dp" android:color="@color/color_divider" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_row_pressed" />
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="11dp"
                android:bottomLeftRadius="11dp"
                android:bottomRightRadius="11dp" />
        </shape>
    </item>
</layer-list>
