<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#DCE9F3" />
            <stroke
                android:width="1dp"
                android:color="#B7CBDA" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#F7FBFF" />
            <stroke
                android:width="1dp"
                android:color="#C3D3DF" />
        </shape>
    </item>
</selector>
