<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#DDE8F1" />
            <stroke
                android:width="1dp"
                android:color="#B8CBD9" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#F7FBFF" />
            <stroke
                android:width="1dp"
                android:color="#C5D5E0" />
        </shape>
    </item>
</selector>
