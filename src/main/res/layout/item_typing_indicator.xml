<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical">

    <FrameLayout
        android:id="@+id/typingAvatarStack"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
            android:id="@+id/ivTypingAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="left|center_vertical"
            android:contentDescription="@null" />

        <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
            android:id="@+id/ivTypingAvatar2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="16dp"
            android:contentDescription="@null" />

        <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
            android:id="@+id/ivTypingAvatar3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="32dp"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/typingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_msg_other"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:minHeight="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/typingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/typingDot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_typing_dot" />

            <View
                android:id="@+id/typingDot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_typing_dot" />

            <View
                android:id="@+id/typingDot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_typing_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTypingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
