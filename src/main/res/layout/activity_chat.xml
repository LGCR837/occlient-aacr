<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <android.support.v7.widget.Toolbar 
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/colorToolbar">

        <LinearLayout 
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="4dp">

                <ImageView
                    android:id="@+id/btnChatBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="@drawable/bg_icon_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@null" />

                <View
                    android:id="@+id/vBackDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="right|top"
                    android:layout_marginRight="6dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_unread_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnChatMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="@null" />
        </LinearLayout>
    </android.support.v7.widget.Toolbar>

    <FrameLayout 
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/pbMessagesLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/chat_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/lvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/space_m"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/btnJumpToUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="@dimen/space_s"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_new_message_bubble"
            android:clickable="true"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:text="跳到未读"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnNewMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:background="@drawable/bg_new_message_bubble"
            android:clickable="true"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:text="新消息"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout 
        android:id="@+id/quote_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorToolbar"
        android:orientation="horizontal"
        android:padding="@dimen/space_s"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQuotePreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnQuoteClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <LinearLayout 
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_s"
        android:background="@color/colorToolbar">

        <ImageView
            android:id="@+id/btnToggleVoice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            app:srcCompat="@drawable/chatting_setmode_voice_btn_normal" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_s"
            android:background="@drawable/bg_chat_input"
            android:hint="输入消息..."
            android:inputType="textMultiLine"
            android:imeOptions="actionSend"
            android:singleLine="false"
            android:minHeight="36dp"
            android:maxLines="4"
            android:gravity="top|left"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextSecondary"
            android:padding="@dimen/space_s" />

        <TextView
            android:id="@+id/btnHoldToTalk"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_s"
            android:gravity="center"
            android:text="按住说话"
            android:textColor="@color/colorTextPrimary"
            android:background="@drawable/bg_hold_to_talk"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="@dimen/space_s"
            android:padding="4dp"
            app:srcCompat="@drawable/icon_chat_plus" />

        <Button
            android:id="@+id/btnSend"
            style="@style/ChatSendButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/space_s"
            android:text="发送" />

        <ProgressBar
            android:id="@+id/pbSend"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/space_s"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/video_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_s"
        android:paddingRight="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVideoProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbVideoProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout 
        android:id="@+id/action_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        android:padding="@dimen/space_m"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout 
                android:id="@+id/btnActionImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout 
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chat_panel_item"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_action_image" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="图片"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <LinearLayout 
                android:id="@+id/btnActionVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout 
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chat_panel_item"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_action_video" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="视频"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <LinearLayout 
                android:id="@+id/btnActionEmoji"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout 
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chat_panel_item"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_action_emoji" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/chat_emoji"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <LinearLayout 
                android:id="@+id/btnActionRedPacket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout 
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chat_panel_item"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_action_red_packet" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/chat_red_packet"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

</LinearLayout>
