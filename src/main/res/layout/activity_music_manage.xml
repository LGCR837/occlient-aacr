<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/btnMusicManageBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_music_top_chip"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous" />

        <TextView
            android:id="@+id/tvMusicManageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="我的上传管理"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMusicManageBatchDelete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_music_action_delete"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="删本页"
            android:textColor="@color/colorDanger"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_music_plaza_card_selector"
        android:gravity="center_vertical"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMusicManageKeyword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="搜索我的歌曲"
            android:imeOptions="actionSearch"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/btnMusicManageSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_music_top_chip_primary"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="查找"
            android:textColor="@color/color_on_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMusicManageSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="4dp"
        android:text=""
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvMusicManagePageInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMusicManagePrev"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_music_top_chip"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="上一页"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMusicManageNext"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_music_top_chip"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="下一页"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_list_item_surface">

        <ListView
            android:id="@+id/lvMusicManage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvMusicManageEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="你还没有上传歌曲"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />
    </FrameLayout>

</LinearLayout>
