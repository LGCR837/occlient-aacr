<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:scrollbars="none">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/color_surface">

            <ImageView
                android:id="@+id/btnCacheBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:contentDescription="@null"
                app:srcCompat="@android:drawable/ic_media_previous"
                android:tint="@color/color_text_primary" />

            <TextView
                android:id="@+id/tvCacheTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="缓存管理"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="缓存总计"
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCacheTotalSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@color/color_background" />

        <LinearLayout 
            android:id="@+id/rowImageCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="图片缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvImageCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearImageCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowVoiceCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="语音缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvVoiceCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearVoiceCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowChatCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="聊天记录缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvChatCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearChatCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowFriendCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="好友列表缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvFriendCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearFriendCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowGroupCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="群列表缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvGroupCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearGroupCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowMomentCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="动态缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMomentCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearMomentCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowRecentCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最近会话缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvRecentCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearRecentCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowUserCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="昵称缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvUserCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearUserCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/rowAvatarMetaCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="头像映射缓存"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvAvatarMetaCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="0 B"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClearAvatarMetaCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="清理"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/flat_button_bg" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:background="@color/color_background" />
    </LinearLayout>
</ScrollView>
