<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnRedPacketSendBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/color_text_primary" />

        <TextView
            android:id="@+id/tvRedPacketSendTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/red_packet_title"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvRedPacketTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_profile_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivRedPacketCoverPreview"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_red_packet" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRedPacketCoverHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/red_packet_image_hint"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnRedPacketPickCover"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/flat_button_bg"
                        android:gravity="center"
                        android:text="@string/red_packet_image_pick"
                        android:textColor="@color/color_button_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnRedPacketClearCover"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_profile_item"
                        android:gravity="center"
                        android:text="@string/red_packet_image_clear"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/etRedPacketTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_item"
                android:hint="@string/red_packet_name_hint"
                android:maxLength="20"
                android:padding="12dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary" />

            <EditText
                android:id="@+id/etRedPacketAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_item"
                android:hint="@string/red_packet_amount_hint"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary" />

            <EditText
                android:id="@+id/etRedPacketCount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_item"
                android:hint="@string/red_packet_count_hint"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary" />

            <TextView
                android:id="@+id/btnSendRedPacket"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/flat_button_bg"
                android:gravity="center"
                android:text="@string/red_packet_send"
                android:textColor="@color/color_button_text" />

            <ProgressBar
                android:id="@+id/pbRedPacketSend"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
