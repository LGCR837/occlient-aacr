<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <LinearLayout 
        android:id="@+id/chat_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="@color/color_surface">

        <TextView
            android:id="@+id/tvChatHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="旧聊"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/btnSwitchAccount"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:padding="4dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_tab_friends"
            android:tint="@color/colorTextPrimary" />

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/btnChatHeaderAdd"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/icon_chat_plus"
            android:tint="@color/colorTextPrimary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbHomeLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="@color/colorDivider"
        android:indeterminate="true"
        android:visibility="gone" />

    <android.support.v7.widget.RecyclerView 
        android:id="@+id/rvRecentChats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:overScrollMode="never" />
</LinearLayout>
