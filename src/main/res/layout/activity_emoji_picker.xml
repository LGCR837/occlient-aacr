<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/color_primary">

        <ImageView
            android:id="@+id/btnEmojiBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginRight="8dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/color_on_primary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvEmojiTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="表情库"
            android:textColor="@color/color_on_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEmojiAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginRight="8dp"
            android:text="添加"
            android:textColor="@color/color_on_primary"
            android:textSize="13sp"
            android:background="@drawable/flat_button_bg" />

        <TextView
            android:id="@+id/btnEmojiManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="管理"
            android:textColor="@color/color_on_primary"
            android:textSize="13sp"
            android:background="@drawable/flat_button_bg" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/svEmojiCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/layoutEmojiCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutEmojiBatchActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/color_surface"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEmojiBatchCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已选 0 项"
            android:textSize="13sp"
            android:textColor="@color/color_text_primary" />

        <TextView
            android:id="@+id/btnEmojiBatchMove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginRight="8dp"
            android:text="移动"
            android:textSize="12sp"
            android:textColor="@color/color_text_primary"
            android:background="@drawable/flat_button_bg" />

        <TextView
            android:id="@+id/btnEmojiBatchDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginRight="8dp"
            android:text="删除"
            android:textSize="12sp"
            android:textColor="@color/color_text_primary"
            android:background="@drawable/flat_button_bg" />

        <TextView
            android:id="@+id/btnEmojiBatchCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="取消"
            android:textSize="12sp"
            android:textColor="@color/color_text_primary"
            android:background="@drawable/flat_button_bg" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmojiEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="暂无表情，点击添加"
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/rvEmojis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
