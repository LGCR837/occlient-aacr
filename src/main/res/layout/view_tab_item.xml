<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tab_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/tabIndicator"
        android:layout_width="18dp"
        android:layout_height="2dp"
        android:background="@color/color_tab_indicator"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp">

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/tabIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />

        <View
            android:id="@+id/tabBadge"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="right|top"
            android:background="@drawable/badge_red_dot"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tabLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/tab_icon_tint"
        android:textSize="12sp" />
</LinearLayout>
