<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <android.support.v4.view.ViewPager
        android:id="@+id/vpMomentGallery"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/btnGalleryBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="12dp"
        android:layout_gravity="top|left"
        android:background="@drawable/flat_button_bg"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous"
        android:tint="@color/color_on_primary"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvGalleryIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_gravity="top|right"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/color_on_primary"
        android:textSize="12sp"
        android:background="@drawable/bg_unread_badge"
        android:contentDescription="@null" />

</FrameLayout>
