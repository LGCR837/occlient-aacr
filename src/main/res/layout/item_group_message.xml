<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvMessageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_time_label"
        android:textColor="@color/color_text_secondary"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <LinearLayout 
        android:id="@+id/message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

    <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
        android:id="@+id/ivAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:contentDescription="@null"
        android:background="@drawable/bg_avatar_round"
        app:srcCompat="@drawable/ic_avatar_placeholder"
        app:cornerRadius="4dp"
        android:visibility="gone" />

    <LinearLayout 
        android:id="@+id/content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sender_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="180dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvSenderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="群主"
                android:textColor="@color/color_on_primary"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:background="@drawable/bg_badge_owner"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSenderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="头衔"
                android:textColor="@color/color_on_primary"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:background="@drawable/bg_badge_title"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout 
                android:id="@+id/quote_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="@drawable/bg_quote_preview"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvQuoteSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="220dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivQuoteImage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginRight="6dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvQuoteContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="240dp"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

        <LinearLayout
            android:id="@+id/message_text_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:id="@+id/message_status_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivMessageStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/read" />

                <TextView
                    android:id="@+id/tvReadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

            <LinearLayout
                android:id="@+id/resource_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/flResourceCover"
                    android:layout_width="168dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
                        android:id="@+id/ivResourceCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:cornerRadius="8dp"
                        app:srcCompat="@drawable/bg_image_placeholder" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#22000000" />

                    <ImageView
                        android:id="@+id/ivResourcePlay"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:alpha="0.92"
                        android:contentDescription="@null"
                        android:tint="@android:color/white"
                        app:srcCompat="@drawable/ic_action_video" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivResourceIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_document" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvResourceTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="220dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/color_text_primary"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvResourceSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="220dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="12sp"
                            android:textColor="@color/color_text_secondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResourceAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="下载"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/red_packet_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minWidth="188dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRedPacketIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_red_packet" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRedPacketTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="220dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/color_on_primary"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvRedPacketDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxWidth="220dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_primary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRedPacketOpenTip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/red_packet_open_tip"
                        android:textSize="11sp"
                        android:textColor="@color/color_on_primary"
                        android:includeFontPadding="false" />

                    <ImageView
                        android:id="@+id/ivRedPacketStatus"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_msg_sent" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/image_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:cornerRadius="4dp"
                    app:srcCompat="@drawable/ic_avatar_placeholder" />

                <ImageView
                    android:id="@+id/ivVideoPlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_action_video" />
            </FrameLayout>

            <LinearLayout 
                android:id="@+id/voice_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivVoiceIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_voice" />

                <ProgressBar
                    android:id="@+id/pbVoiceLoading"
                    style="@android:style/Widget.ProgressBar.Small"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="1&quot;"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/message_status_media_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_gravity="right"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivMessageStatusMedia"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/read" />

                <TextView
                    android:id="@+id/tvReadCountMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
        android:id="@+id/ivAvatarRight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:contentDescription="@null"
        android:background="@drawable/bg_avatar_round"
        app:srcCompat="@drawable/ic_avatar_placeholder"
        app:cornerRadius="4dp"
        android:visibility="gone" />
</LinearLayout>

</LinearLayout>
