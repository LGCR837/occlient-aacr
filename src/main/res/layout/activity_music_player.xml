<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_player_page"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_music_player_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">
        <ImageView
            android:id="@+id/btnMusicPlayerBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_music_player_control_circle"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在播放"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="后台播放 · 通知栏控制"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvMusicPlayerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_music_player_chip"
            android:paddingLeft="9dp"
            android:paddingTop="3dp"
            android:paddingRight="9dp"
            android:paddingBottom="3dp"
            android:text="后台播放"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/btnMusicPlayerDownload"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_music_player_action_btn_primary"
            android:gravity="center"
            android:minWidth="60dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="下载"
            android:textColor="@color/color_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_player_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">
                <FrameLayout
                    android:layout_width="248dp"
                    android:layout_height="248dp"
                    android:background="@drawable/bg_music_player_cover_shell"
                    android:padding="7dp">
                    <ImageView
                        android:id="@+id/ivMusicPlayerCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_music_player_cover_inner"
                        android:contentDescription="歌曲封面"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_placeholder" />
                </FrameLayout>
                <TextView
                    android:id="@+id/tvMusicPlayerSongName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="歌曲名"
                    android:textColor="@color/color_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvMusicPlayerOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="上传者"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvMusicPlayerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_music_player_chip"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="准备播放"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_music_player_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放进度"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/sbMusicPlayerProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_music_player_seekbar"
                    android:thumb="@drawable/bg_music_player_seekbar_thumb"
                    android:thumbOffset="0dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvMusicPlayerCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvMusicPlayerDuration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:text="00:00"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_music_player_card"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/btnMusicPlayerFastForward"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_music_player_control_circle"
                        android:contentDescription="快进10秒"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_media_ff" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="快进"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/btnMusicPlayerPlayPause"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_music_player_control_circle_primary"
                        android:contentDescription="播放或暂停"
                        android:padding="16dp"
                        android:src="@android:drawable/ic_media_play" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="播放/暂停"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/btnMusicPlayerRepeatOne"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_music_player_control_circle"
                        android:contentDescription="单曲循环"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_rotate" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="单曲循环"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/btnMusicPlayerStop"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_music_player_control_circle"
                        android:contentDescription="停止播放"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="停止"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
