<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="248dp"
        android:background="@drawable/bg_moments_cover_placeholder">

        <ImageView
            android:id="@+id/ivMomentsHeaderCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_moments_cover_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_moments_cover_mask" />

        <TextView
            android:id="@+id/tvMomentsHeaderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="92dp"
            android:layout_marginBottom="18dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="我"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <aoharureverie.ocaacrclient.oldchat.ui.widget.RoundedImageView
            android:id="@+id/ivMomentsHeaderAvatar"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="-18dp"
            android:background="@drawable/bg_moments_header_avatar_border"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="centerCrop"
            app:cornerRadius="4dp"
            app:srcCompat="@drawable/ic_avatar_placeholder" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:background="@color/color_surface" />

</LinearLayout>
