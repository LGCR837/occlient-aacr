<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/colorBackground"
            android:paddingLeft="4dp"
            android:paddingRight="16dp">

            <Button
                android:id="@+id/btnBack"
                style="@style/TextLinkButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:minWidth="0dp"
                android:background="@null"
                android:text="&lt; 返回"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/advanced_settings_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/advanced_settings_helper"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/advanced_settings_baseurl_label"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_login"
                android:hint="http://127.0.0.1:8080/v1"
                android:inputType="textUri"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:minHeight="44dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDefaultUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveUrl"
                style="@style/FlatButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/advanced_settings_save" />

            <Button
                android:id="@+id/btnResetUrl"
                style="@style/FlatButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/advanced_settings_reset" />

            <Button
                android:id="@+id/btnServerList"
                style="@style/FlatButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/advanced_settings_server_list" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSkipLogin"
            style="@style/FlatButtonDanger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/advanced_settings_skip_login" />

    </LinearLayout>

</ScrollView>
