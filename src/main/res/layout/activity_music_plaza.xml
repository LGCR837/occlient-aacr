<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMusicPlazaBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_previous" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_music_plaza_card_selector"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingTop="3dp"
                android:paddingRight="6dp"
                android:paddingBottom="3dp">

                <EditText
                    android:id="@+id/etMusicPlazaKeyword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="搜索歌曲 / 上传者"
                    android:imeOptions="actionSearch"
                    android:paddingLeft="8dp"
                    android:paddingTop="7dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="7dp"
                    android:singleLine="true"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnMusicPlazaSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_music_top_chip"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="搜索"
                    android:textColor="@color/color_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMusicPlazaNowPlaying"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_music_top_chip"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="正在播放"
                    android:textColor="@color/color_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnMusicPlazaDownloads"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_music_top_chip"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="我的下载"
                    android:textColor="@color/color_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnMusicPlazaUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_music_top_chip_primary"
                    android:gravity="center"
                    android:minWidth="58dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="我的"
                    android:textColor="@color/color_on_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvMusicPlazaSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:text=""
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐歌曲"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutMusicPlazaRecommendRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvMusicPlazaRecommendEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="暂无推荐歌曲"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="播放量排行"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutMusicPlazaRankingSongs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvMusicPlazaRankingEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="暂无排行歌曲"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="最新歌曲（右滑）"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/hsvMusicPlazaAllSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutMusicPlazaAllSongs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvMusicPlazaAllEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="暂无歌曲"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnMusicPlazaOpenAllList"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_music_top_chip_primary"
                android:gravity="center"
                android:text="全部歌曲"
                android:textColor="@color/color_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutMusicPlazaLegacyHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnMusicPlazaFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="全部歌曲" />

                    <TextView
                        android:id="@+id/btnMusicPlazaFilterMine"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="我的上传" />

                    <TextView
                        android:id="@+id/btnMusicPlazaMineManage"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="管理上传" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMusicPlazaHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMusicPlazaFeaturedCover"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:src="@drawable/ic_avatar_placeholder" />

                    <TextView
                        android:id="@+id/tvMusicPlazaFeaturedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvMusicPlazaFeaturedSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/btnMusicPlazaFeaturedPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播放" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMusicPlazaPageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/btnMusicPlazaPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上一页" />

                <TextView
                    android:id="@+id/btnMusicPlazaNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一页" />

                <ListView
                    android:id="@+id/lvMusicPlaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvMusicPlazaEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无歌曲" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
