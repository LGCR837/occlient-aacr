<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:id="@+id/friendsSearchBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_field"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                app:srcCompat="@android:drawable/ic_menu_search"
                android:tint="@color/color_text_secondary" />

            <EditText
                android:id="@+id/etFriendSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:background="@null"
                android:gravity="center_vertical|left"
                android:hint="搜索好友/群聊"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnClearFriendSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/color_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/friendsSearchDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/friendsSearchBar"
        android:background="@color/color_tab_bar_divider" />

    <ProgressBar
        android:id="@+id/pbFriendsLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/friendsSearchDivider"
        android:indeterminate="true"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvFriends"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pbFriendsLoading"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingTop="10dp"
        android:paddingBottom="90dp" />

    <!-- 折叠菜单 -->
    <LinearLayout 
        android:id="@+id/fabMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="80dp"
        android:orientation="vertical"
        android:gravity="right"
        android:visibility="gone">

        <!-- 创建群聊按钮 -->
        <TextView
            android:id="@+id/fabMenuCreateGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创建群聊"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp"
            android:background="@drawable/fab_menu_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- 添加好友按钮 -->
        <TextView
            android:id="@+id/fabMenuAddFriend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加联系人或群聊"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp"
            android:background="@drawable/fab_menu_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 浮动加号按钮 -->
    <ImageView
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:padding="14dp"
        android:background="@drawable/fab_background"
        app:srcCompat="@drawable/ic_add_floating"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null"/>

</RelativeLayout>
