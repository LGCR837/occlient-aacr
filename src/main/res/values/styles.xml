<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:buttonStyle">@style/RoundedOutlineButton</item>
        <item name="buttonStyle">@style/RoundedOutlineButton</item>
        <item name="android:editTextStyle">@style/FlatInput</item>
        <item name="editTextStyle">@style/FlatInput</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/color_surface</item>
    </style>

    <style name="PopupMenuOverlayLight" parent="Theme.AppCompat.Light">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
    </style>

    <style name="PopupMenuOverlayDark" parent="Theme.AppCompat">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
    </style>

    <style name="RoundedOutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_outline_primary</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TextLinkButton" parent="RoundedOutlineButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="FlatButton" parent="RoundedOutlineButton" />

    <style name="FlatButtonPrimary" parent="RoundedOutlineButton">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/color_on_primary</item>
    </style>

    <style name="ChatSendButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FlatButtonOutline" parent="RoundedOutlineButton" />

    <style name="FlatButtonDanger" parent="RoundedOutlineButton">
        <item name="android:background">@drawable/button_outline_danger</item>
        <item name="android:textColor">@color/colorDanger</item>
    </style>

    <style name="FlatInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/flat_input_bg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
    </style>

    <style name="CrashDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

    <style name="AppDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:editTextStyle">@style/FlatInput</item>
    </style>

    <style name="AppAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
    </style>

    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
